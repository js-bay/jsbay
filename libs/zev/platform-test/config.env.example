# Copy to config.env (gitignored) or export before run.
# Fill in local paths and remote hosts for YOUR workstation — do not commit real values.

# Package root (auto-detected from this directory if unset)
# ZEV_ROOT=/path/to/zev-source

# Build/log output — keep OUTSIDE the git tree
ZEV_OUT_ROOT=/tmp/zev-platform-kit/out

# Toolchains
ZEV_CLANG=clang
ZEV_ZIG=zig
# Android NDK root. The Android zev stress adapter uses its
# API-specific Clang to link the Zig-generated object for Bionic.
# ZEV_ANDROID_NDK=/path/to/android-ndk
ZEV_ANDROID_API=24
# OpenHarmony SDK native directory (contains llvm/ and sysroot/). The Harmony
# adapter links the Zig-generated object with its Clang, which supplies the
# emulated-TLS runtime the Zig linker output lacks.
# ZEV_OHOS_NATIVE=/path/to/ohos-sdk/native
ZEV_ADB=adb
# OpenHarmony Device Connector and the selected target. The Harmony adapter
# transfers the freshly built executable with hdc and runs it through the
# device shell; it does not install a HAP.
# ZEV_HDC=hdc
# ZEV_HARMONY_DEVICE=target-id

# Remote hosts (set only in local config.env — never commit real SSH targets)
# ZEV_LINUX_SSH=user@linux-host
# ZEV_WINDOWS_SSH=user@windows-host
ZEV_WINDOWS_REMOTE_DIR='C:/zev-platform-kit'

# Devices (leave empty unless needed; do not commit real serials/UDIDs).
# iOS automatically uses a booted simulator; set this only to select one.
ZEV_ANDROID_SERIAL=
ZEV_IOS_SIM_UDID=
ZEV_IOS_BUNDLE_ID=org.example.eventloopstress

ZEV_DEFAULT_TIMEOUT_SEC=180
