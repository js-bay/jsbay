+#if JSBAY_INSPECTOR
+static int jsbay_capture_arrow_this(JSContext *ctx, JSFunctionDef *s)
+{
+    JSFunctionDef *fd;
+    int var_idx;
+
+    for (fd = s->parent; fd; fd = fd->parent) {
+        if (fd->has_this_binding) {
+            var_idx = resolve_pseudo_var(ctx, fd, JS_ATOM_this);
+            if (var_idx < 0)
+                return -1;
+            capture_var(fd, &fd->vars[var_idx]);
+            return get_closure_var(ctx, s, fd, JS_CLOSURE_LOCAL, var_idx,
+                                   JS_ATOM_this, false, fd->vars[var_idx].is_lexical,
+                                   JS_VAR_NORMAL) < 0 ? -1 : 0;
+        }
+        if (fd->is_eval) {
+            var_idx = find_closure_var(ctx, fd, JS_ATOM_this);
+            if (var_idx >= 0) {
+                JSClosureVar *cv = &fd->closure_var[var_idx];
+                JSClosureTypeEnum closure_type = cv->closure_type == JS_CLOSURE_GLOBAL ||
+                    cv->closure_type == JS_CLOSURE_GLOBAL_DECL ||
+                    cv->closure_type == JS_CLOSURE_GLOBAL_REF ? JS_CLOSURE_GLOBAL_REF : JS_CLOSURE_REF;
+                return get_closure_var(ctx, s, fd, closure_type, var_idx,
+                                       cv->var_name, cv->is_const, cv->is_lexical,
+                                       cv->var_kind) < 0 ? -1 : 0;
+            }
+        }
+    }
+    return 0;
+}
+#endif
