+static JSFunctionBytecode *jsbay_script_tag_child(JSValue value)
+{
+    if (JS_VALUE_GET_TAG(value) == JS_TAG_FUNCTION_BYTECODE)
+        return JS_VALUE_GET_PTR(value);
+    if (JS_VALUE_GET_TAG(value) == JS_TAG_OBJECT && js_class_has_bytecode(JS_VALUE_GET_OBJ(value)->class_id))
+        return JS_VALUE_GET_OBJ(value)->u.func.function_bytecode;
+    return NULL;
+}
+
+static void jsbay_mark_debug_eval_helper(JSValue value)
+{
+    JSFunctionBytecode *bytecode = jsbay_script_tag_child(value);
+    int index;
+    if (!bytecode || bytecode->jsbay_debug_eval_helper)
+        return;
+    bytecode->jsbay_debug_eval_helper = 1;
+    for (index = 0; index < bytecode->cpool_count; index++)
+        jsbay_mark_debug_eval_helper(bytecode->cpool[index]);
+}
+
+static char *jsbay_debug_eval_source(JSContext *ctx, const char *expr, size_t len, bool strict, bool tdz)
+{
+    static const char hex[] = "0123456789abcdef";
+    const char *prefix = tdz ? "(function(){with(arguments[0]){return class extends null{constructor(){return {value:eval(\"" : strict ? "(function(){with(arguments[0]){return function(){'use strict';return eval(\"" : "(function(){with(arguments[0]){return function(){return eval(\"";
+    const char *suffix = tdz ? "\")};}}}})" : "\")};}})";
+    char *out, *p;
+    size_t index, cap;
+
+    if (len > (SIZE_MAX - 256) / 6)
+        return NULL;
+    cap = len * 6 + 256;
+    out = js_malloc(ctx, cap);
+    if (!out)
+        return NULL;
+    p = out;
+    memcpy(p, prefix, strlen(prefix));
+    p += strlen(prefix);
+    for (index = 0; index < len; index++) {
+        unsigned char c = (unsigned char)expr[index];
+        if (c == '\\' || c == '\"') {
+            *p++ = '\\';
+            *p++ = c;
+        } else if (c < 0x20) {
+            memcpy(p, "\\u00", 4);
+            p += 4;
+            *p++ = hex[c >> 4];
+            *p++ = hex[c & 15];
+        } else if (c == 0xe2 && index + 2 < len && (unsigned char)expr[index + 1] == 0x80 && ((unsigned char)expr[index + 2] == 0xa8 || (unsigned char)expr[index + 2] == 0xa9)) {
+            memcpy(p, (unsigned char)expr[index + 2] == 0xa8 ? "\\u2028" : "\\u2029", 6);
+            p += 6;
+            index += 2;
+        } else {
+            *p++ = c;
+        }
+    }
+    memcpy(p, suffix, strlen(suffix));
+    p += strlen(suffix);
+    *p = '\0';
+    return out;
+}
