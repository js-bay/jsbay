+static void js_notify_location(JSContext *ctx, JSFunctionBytecode *b, const uint8_t *pc)
+{
+    JSRuntime *rt = ctx->rt;
+    int col, line, depth, force_notify;
+    JSStackFrame *frame;
+    const char *filename;
+
+    if (likely(!rt->location_handler))
+        return;
+    rt->debug_pc = pc;
+    line = find_line_num(ctx, b, (uint32_t)(pc - b->byte_code_buf), &col);
+    if (line < 0)
+        return;
+    force_notify = __atomic_exchange_n(&rt->location_force_notify, 0, __ATOMIC_SEQ_CST);
+    if (line == rt->location_last_line && rt->location_last_func == b &&
+        !force_notify)
+        return;
+    rt->location_last_line = line;
+    rt->location_last_func = b;
+    filename = NULL;
+    if (b->filename)
+        filename = JS_AtomToCString(ctx, b->filename);
+    depth = 0;
+    for (frame = rt->current_stack_frame; frame != NULL; frame = frame->prev_frame)
+        depth++;
+    /* Keep the current pc visible to JS_CopyDebugStack while the hook runs. */
+    {
+        JSStackFrame *top = rt->current_stack_frame;
+        uint8_t *saved_pc = NULL;
+        if (top) {
+            saved_pc = top->cur_pc;
+            top->cur_pc = (uint8_t *)pc;
+        }
+        rt->location_handler(ctx, filename ? filename : "", line, col, depth,
+                             rt->location_opaque);
+        if (top)
+            top->cur_pc = saved_pc;
+    }
+    if (filename)
+        JS_FreeCString(ctx, filename);
+}
