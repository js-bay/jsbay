+static JSStackFrame *js_debug_frame(JSContext *ctx, int index)
+{
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    while (sf && index-- > 0)
+        sf = sf->prev_frame;
+    return sf;
+}
+
+int JS_CopyDebugStack(JSContext *ctx, JSDebugFrameInfo *out, int max)
+{
+    JSStackFrame *sf;
+    int count = 0;
+
+    if (!out || max <= 0)
+        return 0;
+    for (sf = ctx->rt->current_stack_frame; sf != NULL && count < max; sf = sf->prev_frame) {
+        JSDebugFrameInfo *frame = &out[count];
+        memset(frame, 0, sizeof(*frame));
+        js_debug_copy_cstr(frame->name, sizeof(frame->name), "<anonymous>");
+        if (JS_VALUE_GET_TAG(sf->cur_func) == JS_TAG_OBJECT) {
+            JSObject *f = JS_VALUE_GET_OBJ(sf->cur_func);
+            JSFunctionBytecode *b;
+            if (f && js_class_has_bytecode(f->class_id)) {
+                b = f->u.func.function_bytecode;
+                if (b) {
+                    /* Sampled from the interrupt handler: copy into the caller
+                       buffer. JS_AtomToCString mallocs. */
+                    if (b->func_name != JS_ATOM_NULL) {
+                        JS_AtomGetStr(ctx, frame->name, (int)sizeof(frame->name), b->func_name);
+                        if (!frame->name[0])
+                            js_debug_copy_cstr(frame->name, sizeof(frame->name), "<anonymous>");
+                    }
+                    if (b->filename != JS_ATOM_NULL)
+                        JS_AtomGetStr(ctx, frame->filename, (int)sizeof(frame->filename), b->filename);
+                    if (sf->cur_pc && b->byte_code_buf && sf->cur_pc >= b->byte_code_buf) {
+                        uint32_t off = (uint32_t)(sf->cur_pc - b->byte_code_buf);
+                        frame->line = find_line_num(ctx, b, off, &frame->column);
+                        if (frame->line < 0) {
+                            frame->line = 0;
+                            frame->column = 0;
+                        }
+                    }
+                }
+            }
+        }
+        count++;
+    }
+    return count;
+}
+
+static JSValue js_debug_local_variables(JSContext *ctx, JSStackFrame *sf)
+{
+    JSValue result = JS_NewObject(ctx);
+    JSObject *f;
+    JSFunctionBytecode *b;
+    uint32_t i;
+
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return result;
+    f = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (!f || !js_class_has_bytecode(f->class_id))
+        return result;
+    b = f->u.func.function_bytecode;
+    if (!b)
+        return result;
+    for (i = 0; i < (uint32_t)(b->arg_count + b->var_count); i++) {
+        JSValue value = i < b->arg_count ? sf->arg_buf[i] : sf->var_buf[i - b->arg_count];
+        if (!JS_IsUninitialized(value))
+            JS_SetProperty(ctx, result, b->vardefs[i].var_name, JS_DupValue(ctx, value));
+    }
+    return result;
+}
+
+static JSValue js_debug_closure_variables(JSContext *ctx, JSStackFrame *sf)
+{
+    JSValue result = JS_NewObject(ctx);
+    JSObject *f;
+    JSFunctionBytecode *b;
+    uint32_t i;
+
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return result;
+    f = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (!f || !js_class_has_bytecode(f->class_id))
+        return result;
+    b = f->u.func.function_bytecode;
+    if (!b)
+        return result;
+    for (i = 0; i < (uint32_t)b->closure_var_count; i++) {
+        JSVarRef *var_ref = f->u.func.var_refs ? f->u.func.var_refs[i] : NULL;
+        JSValue value;
+        if (!var_ref || !var_ref->pvalue)
+            continue;
+        value = *var_ref->pvalue;
+        if (!JS_IsUninitialized(value))
+            JS_SetProperty(ctx, result, b->closure_var[i].var_name, JS_DupValue(ctx, value));
+    }
+    return result;
+}
+
+JSValue JS_CopyDebugScope(JSContext *ctx, int frame_index, int scope)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, frame_index);
+    if (scope == 2 || !sf)
+        return JS_GetGlobalObject(ctx);
+    if (scope == 1)
+        return js_debug_closure_variables(ctx, sf);
+    return js_debug_local_variables(ctx, sf);
+}
+
+JSValue JS_EvalInDebugFrame(JSContext *ctx, int frame_index, const char *expr, size_t len)
+{
+    static const char helper_source[] =
+        "(function(__jsbayScope,__jsbayExpression){"
+        "return (function(){with(__jsbayScope){return eval(__jsbayExpression);}}).call(this);"
+        "})";
+    JSValue local = js_debug_local_variables(ctx, js_debug_frame(ctx, frame_index));
+    JSValue closure = js_debug_closure_variables(ctx, js_debug_frame(ctx, frame_index));
+    JSValue helper;
+    JSValue expression;
+    JSValue args[2];
+    JSValue global;
+    JSValue result;
+
+    if (JS_SetPrototype(ctx, local, closure) < 0) {
+        JS_FreeValue(ctx, closure);
+        JS_FreeValue(ctx, local);
+        return JS_EXCEPTION;
+    }
+    JS_FreeValue(ctx, closure);
+    helper = JS_Eval(ctx, helper_source, sizeof(helper_source) - 1, "<debugger>", JS_EVAL_TYPE_GLOBAL);
+    if (JS_IsException(helper)) {
+        JS_FreeValue(ctx, local);
+        return helper;
+    }
+    expression = JS_NewStringLen(ctx, expr, len);
+    if (JS_IsException(expression)) {
+        JS_FreeValue(ctx, helper);
+        JS_FreeValue(ctx, local);
+        return expression;
+    }
+    args[0] = local;
+    args[1] = expression;
+    /* `this` is a real binding in the frame. `with` does not change it. */
+    global = JS_GetPropertyStr(ctx, local, "this");
+    if (JS_IsException(global) || JS_IsUndefined(global) || JS_IsUninitialized(global)) {
+        JS_FreeValue(ctx, global);
+        global = JS_GetGlobalObject(ctx);
+    }
+    result = JS_Call(ctx, helper, global, 2, args);
+    JS_FreeValue(ctx, global);
+    JS_FreeValue(ctx, expression);
+    JS_FreeValue(ctx, helper);
+    JS_FreeValue(ctx, local);
+    return result;
+}
