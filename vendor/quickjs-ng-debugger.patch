+static void js_debug_copy_cstr(char *dst, size_t dst_len, const char *src)
+{
+    size_t n;
+    if (!src)
+        src = "";
+    n = strlen(src);
+    if (n >= dst_len)
+        n = dst_len - 1;
+    memcpy(dst, src, n);
+    dst[n] = '\0';
+}
