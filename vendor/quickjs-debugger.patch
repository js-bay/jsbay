+static void js_notify_location(JSContext *ctx, JSFunctionBytecode *b, const uint8_t *pc)
+{
+    JSRuntime *rt = ctx->rt;
+    int line, column, depth = 0, force;
+    JSStackFrame *frame;
+    JSStackFrame *current_frame;
+    const uint8_t *saved_pc;
+    const char *filename = NULL;
+    if (!rt->location_handler || (rt->location_work_predicate && !rt->location_work_predicate(rt->location_opaque))) return;
+    line = find_line_num(ctx, b, (int)(pc - b->byte_code_buf), &column);
+    if (line <= 0) return;
+    force = __atomic_exchange_n(&rt->location_force_notify, 0, __ATOMIC_SEQ_CST);
+    if (!force && line == rt->location_last_line && column == rt->location_last_column && rt->location_last_func == b) return;
+    rt->location_last_line = line;
+    rt->location_last_column = column;
+    rt->location_last_func = b;
+    if (b->debug.filename != JS_ATOM_NULL) filename = JS_AtomToCString(ctx, b->debug.filename);
+    current_frame = rt->current_stack_frame;
+    saved_pc = current_frame ? current_frame->cur_pc : NULL;
+    if (current_frame) current_frame->cur_pc = pc + 1;
+    for (frame = rt->current_stack_frame; frame; frame = frame->prev_frame) depth++;
+    rt->location_handler(ctx, filename ? filename : "", line, column, depth, b->jsbay_script_tag, rt->location_opaque);
+    if (current_frame) current_frame->cur_pc = saved_pc;
+    if (filename) JS_FreeCString(ctx, filename);
+}
+
+static JSStackFrame *js_debug_frame(JSContext *ctx, int index)
+{
+    JSStackFrame *frame = ctx->rt->current_stack_frame;
+    while (frame && index-- > 0) frame = frame->prev_frame;
+    return frame;
+}
+
+static JSValue js_debug_local_variables(JSContext *ctx, JSStackFrame *frame)
+{
+    JSFunctionBytecode *bytecode;
+    JSValue result = JS_NewObject(ctx);
+    int index;
+    if (JS_IsException(result) || !frame) return result;
+    bytecode = JS_GetFunctionBytecode(frame->cur_func);
+    if (!bytecode) return result;
+    for (index = 0; index < bytecode->arg_count + bytecode->var_count; index++) {
+        JSValue value = index < bytecode->arg_count ? frame->arg_buf[index] : frame->var_buf[index - bytecode->arg_count];
+        if (!JS_IsUninitialized(value)) JS_SetProperty(ctx, result, bytecode->vardefs[index].var_name, JS_DupValue(ctx, value));
+    }
+    return result;
+}
+
+static JSValue js_debug_closure_variables(JSContext *ctx, JSStackFrame *frame)
+{
+    JSFunctionBytecode *bytecode;
+    JSObject *function;
+    JSValue result = JS_NewObject(ctx);
+    int index;
+    if (JS_IsException(result) || !frame || JS_VALUE_GET_TAG(frame->cur_func) != JS_TAG_OBJECT) return result;
+    function = JS_VALUE_GET_OBJ(frame->cur_func);
+    bytecode = JS_GetFunctionBytecode(frame->cur_func);
+    if (!bytecode || !function->u.func.var_refs) return result;
+    for (index = 0; index < bytecode->closure_var_count; index++) {
+        JSVarRef *ref = function->u.func.var_refs[index];
+        if (ref && ref->pvalue && !JS_IsUninitialized(*ref->pvalue)) JS_SetProperty(ctx, result, bytecode->closure_var[index].var_name, JS_DupValue(ctx, *ref->pvalue));
+    }
+    return result;
+}
+
+JSValue JS_CopyDebugScope(JSContext *ctx, int frame_index, int scope)
+{
+    JSStackFrame *frame = js_debug_frame(ctx, frame_index);
+    if (scope == 2 || !frame) return JS_GetGlobalObject(ctx);
+    if (scope == 1) return js_debug_closure_variables(ctx, frame);
+    return js_debug_local_variables(ctx, frame);
+}
+
+JSValue JS_EvalInDebugFrame(JSContext *ctx, int frame_index, const char *expr, size_t len)
+{
+    static const char helper_source[] = "(function(__jsbayScope,__jsbayExpression){return (function(){with(__jsbayScope){return eval(__jsbayExpression);}}).call(this);})";
+    JSValue local = js_debug_local_variables(ctx, js_debug_frame(ctx, frame_index));
+    JSValue closure = js_debug_closure_variables(ctx, js_debug_frame(ctx, frame_index));
+    JSValue helper, expression, global, result;
+    JSValue args[2];
+    if (JS_IsException(local) || JS_IsException(closure)) {
+        JS_FreeValue(ctx, local);
+        JS_FreeValue(ctx, closure);
+        return JS_EXCEPTION;
+    }
+    if (JS_SetPrototype(ctx, local, closure) < 0) {
+        JS_FreeValue(ctx, closure);
+        JS_FreeValue(ctx, local);
+        return JS_EXCEPTION;
+    }
+    JS_FreeValue(ctx, closure);
+    helper = JS_Eval(ctx, helper_source, sizeof(helper_source) - 1, "<debugger>", JS_EVAL_TYPE_GLOBAL);
+    if (JS_IsException(helper)) { JS_FreeValue(ctx, local); return helper; }
+    expression = JS_NewStringLen(ctx, expr, len);
+    if (JS_IsException(expression)) { JS_FreeValue(ctx, helper); JS_FreeValue(ctx, local); return expression; }
+    args[0] = local;
+    args[1] = expression;
+    global = JS_GetPropertyStr(ctx, local, "this");
+    if (JS_IsException(global) || JS_IsUndefined(global) || JS_IsUninitialized(global)) {
+        JS_FreeValue(ctx, global);
+        global = JS_GetGlobalObject(ctx);
+    }
+    result = JS_Call(ctx, helper, global, 2, args);
+    JS_FreeValue(ctx, global);
+    JS_FreeValue(ctx, expression);
+    JS_FreeValue(ctx, helper);
+    JS_FreeValue(ctx, local);
+    return result;
+}
