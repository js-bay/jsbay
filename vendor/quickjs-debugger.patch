+#define JSBAY_BREAK_LOCATION_MAX 8192
+
+typedef struct {
+    const uint8_t *p;
+    const uint8_t *p_end;
+    int pc;
+    int line;
+    int column;
+    int next_pc;
+    int next_line;
+    int next_column;
+    int has_next;
+} JSBayBreakLocationCursor;
+
+static int jsbay_break_location_cursor_next(JSBayBreakLocationCursor *cursor)
+{
+    uint32_t val;
+    int ret, v;
+    unsigned int op;
+
+    if (cursor->p >= cursor->p_end) {
+        cursor->has_next = 0;
+        return 0;
+    }
+    op = *cursor->p++;
+    if (op == 0) {
+        ret = get_leb128(&val, cursor->p, cursor->p_end);
+        if (ret < 0) return -1;
+        cursor->p += ret;
+        cursor->next_pc = cursor->pc + val;
+        ret = get_sleb128(&v, cursor->p, cursor->p_end);
+        if (ret < 0) return -1;
+        cursor->p += ret;
+        cursor->next_line = cursor->line + v;
+    } else {
+        op -= PC2LINE_OP_FIRST;
+        cursor->next_pc = cursor->pc + (op / PC2LINE_RANGE);
+        cursor->next_line = cursor->line + (op % PC2LINE_RANGE) + PC2LINE_BASE;
+    }
+    ret = get_sleb128(&v, cursor->p, cursor->p_end);
+    if (ret < 0) return -1;
+    cursor->p += ret;
+    cursor->next_column = cursor->column + v;
+    cursor->has_next = 1;
+    return 0;
+}
+
+static int jsbay_break_location_cursor_init(JSBayBreakLocationCursor *cursor, JSFunctionBytecode *bytecode)
+{
+    uint32_t val;
+    int ret;
+
+    if (!bytecode->has_debug || !bytecode->debug.pc2line_buf) return -1;
+    cursor->p = bytecode->debug.pc2line_buf;
+    cursor->p_end = cursor->p + bytecode->debug.pc2line_len;
+    ret = get_leb128(&val, cursor->p, cursor->p_end);
+    if (ret < 0) return -1;
+    cursor->p += ret;
+    cursor->line = val + 1;
+    ret = get_leb128(&val, cursor->p, cursor->p_end);
+    if (ret < 0) return -1;
+    cursor->p += ret;
+    cursor->column = val + 1;
+    cursor->pc = 0;
+    cursor->has_next = 0;
+    return jsbay_break_location_cursor_next(cursor);
+}
+
+static int jsbay_break_location_cursor_line(JSBayBreakLocationCursor *cursor, int pc, int *column)
+{
+    while (cursor->has_next && pc >= cursor->next_pc) {
+        cursor->pc = cursor->next_pc;
+        cursor->line = cursor->next_line;
+        cursor->column = cursor->next_column;
+        if (jsbay_break_location_cursor_next(cursor) < 0) return 0;
+    }
+    *column = cursor->column;
+    return cursor->line;
+}
+
+static void jsbay_collect_break_locations_one(JSContext *ctx, JSFunctionBytecode *bytecode, const char *filename, uint64_t script_tag, JSFunctionBytecode **ancestors, int depth, int *count, int *truncated)
+{
+    JSRuntime *rt = ctx->rt;
+    JSBayBreakLocationCursor cursor;
+    int last_line = -1, last_column = -1;
+    int pc, index;
+    if (!rt->break_location_handler || *truncated || depth >= JSBAY_SCRIPT_TAG_MAX_DEPTH) return;
+    for (index = 0; index < depth; index++) if (ancestors[index] == bytecode) return;
+    ancestors[depth] = bytecode;
+    if (jsbay_break_location_cursor_init(&cursor, bytecode) < 0) return;
+    for (pc = 0; pc < bytecode->byte_code_len;) {
+        int column;
+        int opcode_size = jsbay_opcode_size(bytecode->byte_code_buf[pc]);
+        if (opcode_size <= 0 || opcode_size > bytecode->byte_code_len - pc) return;
+        int line = jsbay_break_location_cursor_line(&cursor, pc, &column);
+        if (line > 0 && (line != last_line || column != last_column)) {
+            if (*count >= JSBAY_BREAK_LOCATION_MAX) {
+                *truncated = 1;
+                return;
+            }
+            last_line = line;
+            last_column = column;
+            rt->break_location_handler(ctx, filename, line, column, script_tag, 0, 0, rt->break_location_opaque);
+            (*count)++;
+        }
+        pc += opcode_size;
+    }
+    for (index = 0; index < bytecode->cpool_count; index++) {
+        JSFunctionBytecode *child = jsbay_script_tag_child(bytecode->cpool[index]);
+        if (child) jsbay_collect_break_locations_one(ctx, child, filename, script_tag, ancestors, depth + 1, count, truncated);
+        if (*truncated) return;
+    }
+}
+
+static void jsbay_collect_break_locations(JSContext *ctx, JSFunctionBytecode *bytecode, const char *filename, uint64_t script_tag)
+{
+    JSFunctionBytecode *ancestors[JSBAY_SCRIPT_TAG_MAX_DEPTH];
+    JSRuntime *rt = ctx->rt;
+    int count = 0, truncated = 0;
+    if (!rt->break_location_handler) return;
+    jsbay_collect_break_locations_one(ctx, bytecode, filename, script_tag, ancestors, 0, &count, &truncated);
+    rt->break_location_handler(ctx, NULL, 0, 0, script_tag, 1, truncated, rt->break_location_opaque);
+}
