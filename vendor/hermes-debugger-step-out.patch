+struct ReturnRestoreObserver : public debugger::EventObserver {
+  explicit ReturnRestoreObserver(std::shared_ptr<HermesRuntime> runtime)
+      : runtime(std::move(runtime)) {}
+
+  Command didPause(Debugger &debugger) override {
+    const auto reason = debugger.getProgramState().getPauseReason();
+    if (reason == PauseReason::Breakpoint) {
+      ++breakpointPauses;
+      if (!requestedAsyncPause) {
+        requestedAsyncPause = true;
+        debugger.triggerAsyncPause(AsyncPauseKind::Implicit);
+      }
+    } else if (reason == PauseReason::AsyncTriggerImplicit) {
+      ++implicitPauses;
+      runtime->global().getPropertyAsFunction(*runtime, "eval").call(
+          *runtime, "__retRestoreProbe(0);");
+    }
+    return Command::continueExecution();
+  }
+
+  std::shared_ptr<HermesRuntime> runtime;
+  bool requestedAsyncPause{false};
+  uint32_t breakpointPauses{0};
+  uint32_t implicitPauses{0};
+};
