+TEST_F(DebuggerAPITest, ReturnBreakpointRestoresOnlyItsOwnFrame) {
+  eval(
+      "function __retRestoreProbe(n) {\n"
+      "  if (n > 0) __retRestoreProbe(n - 1);\n"
+      "  return n;\n"
+      "}\n");
+  const auto scripts = rt->getDebugger().getLoadedScripts();
+  ASSERT_FALSE(scripts.empty());
+  SourceLocation location = scripts.back();
+  location.line = 3;
+  location.column = 1;
+  ASSERT_NE(kInvalidBreakpoint, rt->getDebugger().setBreakpoint(location));
+
+  ReturnRestoreObserver returnObserver(rt);
+  rt->getDebugger().setEventObserver(&returnObserver);
+  eval("__retRestoreProbe(1);");
+
+  EXPECT_EQ(1u, returnObserver.implicitPauses);
+  EXPECT_EQ(2u, returnObserver.breakpointPauses);
+}
