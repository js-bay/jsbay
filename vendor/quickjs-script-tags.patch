+void JS_SetScriptTagHandler(JSRuntime *rt, JSScriptTagHandler *cb, void *opaque)
+{
+    rt->jsbay_script_tag_handler = cb;
+    rt->jsbay_script_tag_opaque = opaque;
+}
+
+static JSFunctionBytecode *jsbay_script_tag_child(JSValue value)
+{
+    if (JS_VALUE_GET_TAG(value) == JS_TAG_FUNCTION_BYTECODE)
+        return JS_VALUE_GET_PTR(value);
+    if (JS_VALUE_GET_TAG(value) == JS_TAG_OBJECT &&
+        js_class_has_bytecode(JS_VALUE_GET_OBJ(value)->class_id))
+        return JS_VALUE_GET_OBJ(value)->u.func.function_bytecode;
+    return NULL;
+}
+
+static int jsbay_script_tag_tree_valid(JSFunctionBytecode *b,
+                                       JSFunctionBytecode **ancestors, int depth)
+{
+    int i;
+    if (depth >= JSBAY_SCRIPT_TAG_MAX_DEPTH) return -1;
+    for (i = 0; i < depth; i++) if (ancestors[i] == b) return -1;
+    ancestors[depth] = b;
+    for (i = 0; i < b->cpool_count; i++) {
+        JSFunctionBytecode *child = jsbay_script_tag_child(b->cpool[i]);
+        if (child && jsbay_script_tag_tree_valid(child, ancestors, depth + 1)) return -1;
+    }
+    return 0;
+}
+
+static void jsbay_set_script_tag(JSFunctionBytecode *b, uint64_t tag,
+                                 JSFunctionBytecode **ancestors, int depth)
+{
+    int i;
+    ancestors[depth] = b;
+    b->jsbay_script_tag = tag;
+    for (i = 0; i < b->cpool_count; i++) {
+        JSFunctionBytecode *child = jsbay_script_tag_child(b->cpool[i]);
+        if (child) jsbay_set_script_tag(child, tag, ancestors, depth + 1);
+    }
+}
+
+uint64_t JS_RebindScriptTag(JSContext *ctx, JSValueConst value,
+                            const char *filename, const char *source, size_t source_len)
+{
+    JSFunctionBytecode *b;
+    JSFunctionBytecode *ancestors[JSBAY_SCRIPT_TAG_MAX_DEPTH];
+    uint64_t tag;
+    if (!ctx || !ctx->rt->jsbay_script_tag_handler || !filename || !source) return 0;
+    if (JS_VALUE_GET_TAG(value) != JS_TAG_FUNCTION_BYTECODE) return 0;
+    b = JS_VALUE_GET_PTR(value);
+    if (jsbay_script_tag_tree_valid(b, ancestors, 0)) return 0;
+    tag = ctx->rt->jsbay_script_tag_handler(ctx, filename, source, source_len,
+                                             ctx->rt->jsbay_script_tag_opaque);
+    if (tag) jsbay_set_script_tag(b, tag, ancestors, 0);
+    return tag;
+}
+#endif
