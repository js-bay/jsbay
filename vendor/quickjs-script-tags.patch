+static void jsbay_note_source_url(JSParseState *s, const uint8_t *begin, const uint8_t *end)
+{
+    const uint8_t *p = begin;
+    const uint8_t *url;
+    if (end - p < 12 || (*p != '#' && *p != '@')) return;
+    if ((p[1] != ' ' && p[1] != '\t') || memcmp(p + 2, "sourceURL=", 10)) return;
+    url = p + 12;
+    while (url < end && (*url == ' ' || *url == '\t')) url++;
+    while (end > url && (end[-1] == ' ' || end[-1] == '\t')) end--;
+    if (url == end) return;
+    for (p = url; p < end; p++) if (*p == ' ' || *p == '\t' || *p == '\r') return;
+    s->jsbay_source_url = url;
+    s->jsbay_source_url_len = end - url;
+}
+#endif
