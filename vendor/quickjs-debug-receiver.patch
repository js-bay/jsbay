+static char *jsbay_debug_eval_source(JSContext *ctx, const char *expr, size_t len, int strict, int tdz)
+{
+    static const char hex[] = "0123456789abcdef";
+    const char *prefix = tdz ? "(function(){with(arguments[0]){return class extends null{constructor(){return {value:eval(\"" : strict ? "(function(){with(arguments[0]){return function(){'use strict';return eval(\"" : "(function(){with(arguments[0]){return function(){return eval(\"";
+    const char *suffix = tdz ? "\")};}}}})" : "\")};}})";
+    char *out, *p;
+    size_t index, cap;
+    if (len > (SIZE_MAX - 256) / 6) return NULL;
+    cap = len * 6 + 256;
+    out = js_malloc(ctx, cap);
+    if (!out) return NULL;
+    p = out;
+    memcpy(p, prefix, strlen(prefix)); p += strlen(prefix);
+    for (index = 0; index < len; index++) {
+        unsigned char c = (unsigned char)expr[index];
+        if (c == '\\' || c == '\"') { *p++ = '\\'; *p++ = c; }
+        else if (c < 0x20) { memcpy(p, "\\u00", 4); p += 4; *p++ = hex[c >> 4]; *p++ = hex[c & 15]; }
+        else if (c == 0xe2 && index + 2 < len && (unsigned char)expr[index + 1] == 0x80 && ((unsigned char)expr[index + 2] == 0xa8 || (unsigned char)expr[index + 2] == 0xa9)) { memcpy(p, (unsigned char)expr[index + 2] == 0xa8 ? "\\u2028" : "\\u2029", 6); p += 6; index += 2; }
+        else *p++ = c;
+    }
+    memcpy(p, suffix, strlen(suffix)); p += strlen(suffix);
+    *p = '\0';
+    return out;
+}
