+/* CDP asks for legal breakpoint locations before JS_EvalFunctionInternal
+   releases transient top-level bytecode. Reuse the engine pc2line map rather
+   than deriving executable positions from source text. */
+#define JS_BREAK_LOCATION_MAX 8192
+#define JS_BREAK_LOCATION_MAX_DEPTH 32
+
+static void js_collect_break_locations_one(JSContext *ctx,
+                                           JSFunctionBytecode *b,
+                                           JSFunctionBytecode **ancestors,
+                                           int depth, int *count,
+                                           int *truncated)
+{
+    const uint8_t *p, *p_end;
+    int i, line, col, pc, ret, new_line, new_col;
+    int32_t delta;
+    unsigned int op;
+    const char *filename = NULL;
+
+    if (depth >= JS_BREAK_LOCATION_MAX_DEPTH) {
+        *truncated = 1;
+        return;
+    }
+    for (i = 0; i < depth; i++) {
+        if (ancestors[i] == b)
+            return;
+    }
+    ancestors[depth] = b;
+    if (b->filename)
+        filename = JS_AtomToCString(ctx, b->filename);
+    if (b->byte_code_len > 0) {
+        line = b->line_num;
+        col = b->col_num;
+        if (line >= 1) {
+            if (*count >= JS_BREAK_LOCATION_MAX) {
+                *truncated = 1;
+            } else {
+                ctx->rt->break_location_handler(ctx, filename ? filename : "", line,
+                                                col, 0, 0,
+                                                ctx->rt->break_location_opaque);
+                (*count)++;
+            }
+        }
+        if (b->pc2line_buf) {
+            p = b->pc2line_buf;
+            p_end = p + b->pc2line_len;
+            pc = 0;
+            while (p < p_end && !*truncated) {
+                op = *p++;
+                if (op == 0) {
+                    uint32_t value;
+                    ret = get_leb128(&value, p, p_end);
+                    if (ret < 0)
+                        break;
+                    pc += value;
+                    p += ret;
+                    ret = get_sleb128(&delta, p, p_end);
+                    if (ret < 0)
+                        break;
+                    p += ret;
+                    new_line = line + delta;
+                } else {
+                    op -= PC2LINE_OP_FIRST;
+                    pc += op / PC2LINE_RANGE;
+                    new_line = line + (op % PC2LINE_RANGE) + PC2LINE_BASE;
+                }
+                ret = get_sleb128(&delta, p, p_end);
+                if (ret < 0)
+                    break;
+                p += ret;
+                new_col = col + delta;
+                if (pc >= b->byte_code_len)
+                    break;
+                line = new_line;
+                col = new_col;
+                if (line < 1)
+                    continue;
+                if (*count >= JS_BREAK_LOCATION_MAX) {
+                    *truncated = 1;
+                    break;
+                }
+                ctx->rt->break_location_handler(ctx, filename ? filename : "", line,
+                                                col, 0, 0,
+                                                ctx->rt->break_location_opaque);
+                (*count)++;
+            }
+        }
+    }
+    if (filename)
+        JS_FreeCString(ctx, filename);
+    for (i = 0; i < b->cpool_count && !*truncated; i++) {
+        JSValue value = b->cpool[i];
+        JSFunctionBytecode *child = NULL;
+        if (JS_VALUE_GET_TAG(value) == JS_TAG_FUNCTION_BYTECODE) {
+            child = JS_VALUE_GET_PTR(value);
+        } else if (JS_VALUE_GET_TAG(value) == JS_TAG_OBJECT &&
+                   js_class_has_bytecode(JS_VALUE_GET_OBJ(value)->class_id)) {
+            child = JS_VALUE_GET_OBJ(value)->u.func.function_bytecode;
+        }
+        if (!child)
+            continue;
+        js_collect_break_locations_one(ctx, child, ancestors,
+                                       depth + 1, count, truncated);
+    }
+}
+
+static void js_collect_break_locations(JSContext *ctx, JSFunctionBytecode *b)
+{
+    JSFunctionBytecode *ancestors[JS_BREAK_LOCATION_MAX_DEPTH];
+    int count = 0, truncated = 0;
+
+    if (!ctx->rt->break_location_handler)
+        return;
+    js_collect_break_locations_one(ctx, b, ancestors, 0, &count, &truncated);
+    ctx->rt->break_location_handler(ctx, NULL, 0, 0, 1, truncated,
+                                    ctx->rt->break_location_opaque);
+}
