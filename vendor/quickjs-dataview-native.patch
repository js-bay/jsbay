+JSValue JS_GetDataViewBuffer(JSContext *ctx, JSValueConst obj,
+                             size_t *pbyte_offset,
+                             size_t *pbyte_length)
+{
+    JSObject *p;
+    JSTypedArray *ta;
+    JSArrayBuffer *abuf;
+
+    if (pbyte_offset)
+        *pbyte_offset = 0;
+    if (pbyte_length)
+        *pbyte_length = 0;
+
+    if (!JS_IsDataView(obj))
+        return JS_UNDEFINED;
+    p = JS_VALUE_GET_OBJ(obj);
+    if (dataview_is_oob(p))
+        return JS_UNDEFINED;
+    ta = p->u.typed_array;
+    if (pbyte_offset)
+        *pbyte_offset = ta->offset;
+    if (pbyte_length) {
+        abuf = ta->buffer->u.array_buffer;
+        *pbyte_length = ta->track_rab ? abuf->byte_length - ta->offset : ta->length;
+    }
+    return JS_DupValue(ctx, JS_MKPTR(JS_TAG_OBJECT, ta->buffer));
+}
