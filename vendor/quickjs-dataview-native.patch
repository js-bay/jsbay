+int JS_IsDataView(JSValueConst val)
+{
+    return JS_VALUE_GET_TAG(val) == JS_TAG_OBJECT &&
+           JS_VALUE_GET_OBJ(val)->class_id == JS_CLASS_DATAVIEW;
+}
