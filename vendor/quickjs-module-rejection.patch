+static void js_promise_set_handled(JSContext *ctx, JSValueConst promise)
+{
+    JSPromiseData *s = JS_GetOpaque(promise, JS_CLASS_PROMISE);
+    if (!s)
+        return;
+    if (s->promise_state == JS_PROMISE_REJECTED && !s->is_handled &&
+        ctx->rt->host_promise_rejection_tracker) {
+        ctx->rt->host_promise_rejection_tracker(ctx, promise, s->promise_result,
+                                               TRUE,
+                                               ctx->rt->host_promise_rejection_tracker_opaque);
+    }
+    s->is_handled = TRUE;
 }
 
