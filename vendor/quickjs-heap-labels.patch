+/*
+ * Heap snapshots cannot use JS_AtomGetStrRT: its fixed debug buffer silently
+ * truncates names and makes embedded NUL bytes indistinguishable from an end
+ * of string.  This reads only the atom table and uses libc allocation, so a
+ * walk neither evaluates JavaScript nor allocates through the engine.
+ */
+#define JSBAY_HEAP_LABEL_MAX_BYTES (16 * 1024)
+
+static int js_heap_write_utf8(char *out, size_t cap, size_t *pos, uint32_t c)
+{
+    size_t n;
+    if (c < 0x80) n = 1;
+    else if (c < 0x800) n = 2;
+    else if (c < 0x10000) n = 3;
+    else n = 4;
+    if (*pos > cap - n || *pos > JSBAY_HEAP_LABEL_MAX_BYTES - n)
+        return -1;
+    if (n == 1) out[(*pos)++] = c;
+    else if (n == 2) {
+        out[(*pos)++] = 0xc0 | (c >> 6);
+        out[(*pos)++] = 0x80 | (c & 0x3f);
+    } else if (n == 3) {
+        out[(*pos)++] = 0xe0 | (c >> 12);
+        out[(*pos)++] = 0x80 | ((c >> 6) & 0x3f);
+        out[(*pos)++] = 0x80 | (c & 0x3f);
+    } else {
+        out[(*pos)++] = 0xf0 | (c >> 18);
+        out[(*pos)++] = 0x80 | ((c >> 12) & 0x3f);
+        out[(*pos)++] = 0x80 | ((c >> 6) & 0x3f);
+        out[(*pos)++] = 0x80 | (c & 0x3f);
     }
+    return 0;
 }
 
+/* Returns malloc-owned UTF-8 bytes, or NULL when a label is not precise. */
+static char *js_heap_atom_name(JSRuntime *rt, JSAtom atom, size_t *name_len)
+{
+    JSAtomStruct *p;
+    JSString *str;
+    char number[32];
+    char *out;
+    size_t cap, pos = 0, len;
+    uint32_t c;
+    int i;
+
+    *name_len = 0;
+    if (__JS_AtomIsTaggedInt(atom)) {
+        int n = snprintf(number, sizeof(number), "%u", __JS_AtomToUInt32(atom));
+        if (n < 0 || (size_t)n >= sizeof(number))
+            return NULL;
+        out = (malloc)((size_t)n + 1);
+        if (!out)
+            return NULL;
+        memcpy(out, number, (size_t)n + 1);
+        *name_len = (size_t)n;
+        return out;
+    }
+    if (atom == JS_ATOM_NULL || atom >= rt->atom_size)
+        return NULL;
+    p = rt->atom_array[atom];
+    /* Symbols have no lossless property-name spelling in this protocol. */
+    if (!p || atom_is_free(p) || p->atom_type != JS_ATOM_TYPE_STRING)
+        return NULL;
+    str = p;
+    len = str->len;
+    if (len > JSBAY_HEAP_LABEL_MAX_BYTES)
+        return NULL;
+    if (len > (SIZE_MAX - 1) / 3)
+        return NULL;
+    cap = len * 3;
+    out = (malloc)(cap + 1);
+    if (!out)
+        return NULL;
+    for (i = 0; i < str->len; i++) {
+        c = string_get(str, i);
+        if (str->is_wide_char && c >= 0xd800 && c <= 0xdbff &&
+            i + 1 < str->len) {
+            uint32_t lo = string_get(str, i + 1);
+            if (lo >= 0xdc00 && lo <= 0xdfff) {
+                c = 0x10000 + ((c - 0xd800) << 10) + (lo - 0xdc00);
+                i++;
+            }
+        }
+        if (c >= 0xd800 && c <= 0xdfff ||
+            js_heap_write_utf8(out, cap, &pos, c)) {
+            (free)(out);
+            return NULL;
+        }
+    }
+    out[pos] = '\0';
+    *name_len = pos;
+    return out;
+}
