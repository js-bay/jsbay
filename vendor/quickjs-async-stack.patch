+static void jsbay_qjs_copy_debug_string(char *dst, size_t dst_len, const char *src)
+{
+    if (!src)
+        src = "";
+    snprintf(dst, dst_len, "%s", src);
+}
+
+int JS_CopyDebugStack(JSContext *ctx, JSDebugFrameInfo *out, int max)
+{
+    JSStackFrame *sf;
+    int count = 0;
+
+    if (!ctx || !out || max <= 0)
+        return 0;
+    for (sf = ctx->rt->current_stack_frame; sf && count < max; sf = sf->prev_frame) {
+        JSDebugFrameInfo *frame = &out[count];
+        JSFunctionBytecode *b = JS_GetFunctionBytecode(sf->cur_func);
+        memset(frame, 0, sizeof(*frame));
+        jsbay_qjs_copy_debug_string(frame->name, sizeof(frame->name), "<anonymous>");
+        if (b) {
+            char buf[512];
+            if (b->func_name != JS_ATOM_NULL) {
+                jsbay_qjs_copy_debug_string(frame->name, sizeof(frame->name),
+                                       JS_AtomGetStr(ctx, buf, sizeof(buf), b->func_name));
+            }
+            if (b->debug.filename != JS_ATOM_NULL) {
+                jsbay_qjs_copy_debug_string(frame->filename, sizeof(frame->filename),
+                                       JS_AtomGetStr(ctx, buf, sizeof(buf), b->debug.filename));
+            }
+            if (sf->cur_pc && b->byte_code_buf && sf->cur_pc >= b->byte_code_buf) {
+                uint32_t off = (uint32_t)(sf->cur_pc - b->byte_code_buf);
+                frame->line = find_line_num(ctx, b, off, &frame->column);
+            }
+        }
+        count++;
+    }
+    return count;
+}
