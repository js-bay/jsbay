+static int js_debug_next_pc2line(const uint8_t **pp, const uint8_t *p_end,
+                                 int *pc, int *line, int *col)
+{
+    const uint8_t *p = *pp;
+    int ret, new_line, new_col;
+    int32_t delta;
+    unsigned int op;
 
+    if (p >= p_end)
+        return 0;
+    op = *p++;
+    if (op == 0) {
+        uint32_t value;
+        ret = get_leb128(&value, p, p_end);
+        if (ret < 0 || value > INT_MAX - *pc)
+            return -1;
+        *pc += value;
+        p += ret;
+        ret = get_sleb128(&delta, p, p_end);
+        if (ret < 0)
+            return -1;
+        p += ret;
+        new_line = *line + delta;
+    } else {
+        op -= PC2LINE_OP_FIRST;
+        if (op > INT_MAX || op / PC2LINE_RANGE > INT_MAX - *pc)
+            return -1;
+        *pc += op / PC2LINE_RANGE;
+        new_line = *line + (op % PC2LINE_RANGE) + PC2LINE_BASE;
+    }
+    ret = get_sleb128(&delta, p, p_end);
+    if (ret < 0)
+        return -1;
+    p += ret;
+    new_col = *col + delta;
+    *pp = p;
+    *line = new_line;
+    *col = new_col;
+    return 1;
+}
