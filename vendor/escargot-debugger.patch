+ValueRef* DebuggerOperationsRef::BreakpointOperations::evalValue(StringRef* sourceCode, ValueRef*& exception)
+{
+    ExecutionState* state = toImpl(m_executionState);
+    Debugger* debugger = state->context()->debugger();
+    exception = nullptr;
+
+    if (debugger == nullptr) {
+        exception = ErrorObjectRef::create(toRef(state), ErrorObjectRef::Code::TypeError, StringRef::createFromASCII("Debugger is not available"));
+        return nullptr;
+    }
+
+    debugger->setStopState(ESCARGOT_DEBUGGER_IN_EVAL_MODE);
+    try {
+        Value asValue(toImpl(sourceCode));
+        Value result = state->context()->globalObject()->evalLocal(*state, asValue, state->debuggerThisValue(), reinterpret_cast<ByteCodeBlock*>(m_weakCodeRef)->m_codeBlock, true);
+        debugger->setStopState(ESCARGOT_DEBUGGER_IN_WAIT_MODE);
+        return toRef(result);
+    } catch (const Value& value) {
+        exception = toRef(value);
+        debugger->setStopState(ESCARGOT_DEBUGGER_IN_WAIT_MODE);
+        return nullptr;
+    }
+}
+
+ValueRef* DebuggerOperationsRef::BreakpointOperations::frameThis(uint32_t stateIndex)
+{
+    ExecutionState* state = toImpl(m_executionState);
+    while (stateIndex > 0 && state) {
+        state = state->parent();
+        stateIndex--;
+    }
+    return state ? toRef(state->debuggerThisValue()) : nullptr;
+}
+
+uint64_t DebuggerOperationsRef::BreakpointOperations::frameToken()
+{
+    return toImpl(m_executionState)->debuggerFrameToken();
+}
+
+bool DebuggerOperationsRef::BreakpointOperations::isRepeatedLocation(uint32_t line)
+{
+    ExecutionState* state = toImpl(m_executionState);
+    return state->debuggerRepeatedLocation(reinterpret_cast<ByteCodeBlock*>(m_weakCodeRef), m_offset, line);
+}
