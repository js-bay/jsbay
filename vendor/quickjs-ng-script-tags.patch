+static int js_check_debugger_script_tag_tree(JSFunctionBytecode *b,
+                                             JSFunctionBytecode **ancestors, int depth)
+{
+    int i;
+    if (depth >= JS_BREAK_LOCATION_MAX_DEPTH) return -1;
+    for (i = 0; i < depth; i++) if (ancestors[i] == b) return 0;
+    ancestors[depth] = b;
+    for (i = 0; i < b->cpool_count; i++) {
+        JSValue value = b->cpool[i];
+        JSFunctionBytecode *child = NULL;
+        if (JS_VALUE_GET_TAG(value) == JS_TAG_FUNCTION_BYTECODE)
+            child = JS_VALUE_GET_PTR(value);
+        else if (JS_VALUE_GET_TAG(value) == JS_TAG_OBJECT && js_class_has_bytecode(JS_VALUE_GET_OBJ(value)->class_id))
+            child = JS_VALUE_GET_OBJ(value)->u.func.function_bytecode;
+        if (child && js_check_debugger_script_tag_tree(child, ancestors, depth + 1)) return -1;
+    }
+    return 0;
+}
+
+static void js_set_debugger_script_tag_one(JSFunctionBytecode *b, uint64_t tag,
+                                           JSFunctionBytecode **ancestors, int depth)
+{
+    int i;
+    for (i = 0; i < depth; i++) if (ancestors[i] == b) return;
+    ancestors[depth] = b;
+    b->debugger_script_tag = tag;
+    for (i = 0; i < b->cpool_count; i++) {
+        JSValue value = b->cpool[i];
+        JSFunctionBytecode *child = NULL;
+        if (JS_VALUE_GET_TAG(value) == JS_TAG_FUNCTION_BYTECODE)
+            child = JS_VALUE_GET_PTR(value);
+        else if (JS_VALUE_GET_TAG(value) == JS_TAG_OBJECT && js_class_has_bytecode(JS_VALUE_GET_OBJ(value)->class_id))
+            child = JS_VALUE_GET_OBJ(value)->u.func.function_bytecode;
+        if (child) js_set_debugger_script_tag_one(child, tag, ancestors, depth + 1);
+    }
+}
+
+static int js_set_debugger_script_tag(JSValueConst value, uint64_t tag)
+{
+    JSFunctionBytecode *ancestors[JS_BREAK_LOCATION_MAX_DEPTH];
+    if (!tag || JS_VALUE_GET_TAG(value) != JS_TAG_FUNCTION_BYTECODE) return -1;
+    if (js_check_debugger_script_tag_tree(JS_VALUE_GET_PTR(value), ancestors, 0)) return -1;
+    js_set_debugger_script_tag_one(JS_VALUE_GET_PTR(value), tag, ancestors, 0);
+    return 0;
 }
 
+uint64_t JS_RebindScriptTag(JSContext *ctx, JSValueConst value, const char *filename,
+                            const char *source, size_t source_len)
+{
+    uint64_t tag;
+    if (!ctx->rt->script_tag_handler || !filename || !source) return 0;
+    if (JS_VALUE_GET_TAG(value) != JS_TAG_FUNCTION_BYTECODE) return 0;
+    {
+        JSFunctionBytecode *ancestors[JS_BREAK_LOCATION_MAX_DEPTH];
+        if (js_check_debugger_script_tag_tree(JS_VALUE_GET_PTR(value), ancestors, 0)) return 0;
+    }
+    tag = ctx->rt->script_tag_handler(ctx, filename, source, source_len, ctx->rt->script_tag_opaque);
+    if (js_set_debugger_script_tag(value, tag)) return 0;
+    return tag;
+}
