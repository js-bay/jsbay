+int JS_GetDebugStackDepth(JSContext *ctx)
+{
+    JSStackFrame *sf;
+    int depth = 0;
+    if (!ctx)
+        return 0;
+    for (sf = ctx->rt->current_stack_frame; sf != NULL; sf = sf->prev_frame)
+        depth++;
+    return depth;
+}
+
+int JS_IsDebugLocationRepeat(JSContext *ctx)
+{
+#if JSBAY_INSPECTOR
+    return ctx && ctx->rt->jsbay_location_callback_active && ctx->rt->jsbay_location_repeat;
+#else
+    (void)ctx;
+    return 0;
+#endif
+}
+
+uint64_t JS_GetDebugFrameToken(JSContext *ctx)
+{
+#if JSBAY_INSPECTOR
+    JSStackFrame *frame;
+    if (ctx) {
+        for (frame = ctx->rt->current_stack_frame; frame; frame = frame->prev_frame) {
+            if (frame->jsbay_debug_token)
+                return frame->jsbay_debug_token;
+        }
+    }
+#else
+    (void)ctx;
+#endif
+    return 0;
+}
