+/* Attach native observers without consulting promise.constructor or
+   Symbol.species. The returned intrinsic Promise exists only to satisfy the
+   reaction machinery and is immediately released by the embedding caller. */
+JSValue JS_BayPromiseThen(JSContext *ctx, JSValueConst promise,
+                          JSValueConst on_fulfilled,
+                          JSValueConst on_rejected)
+{
+    JSValue result_promise, resolving_funcs[2];
+    JSValueConst handlers[2];
+    int ret, i;
+
+    if (!JS_GetOpaque2(ctx, promise, JS_CLASS_PROMISE))
+        return JS_EXCEPTION;
+    result_promise = JS_NewPromiseCapability(ctx, resolving_funcs);
+    if (JS_IsException(result_promise))
+        return result_promise;
+    handlers[0] = on_fulfilled;
+    handlers[1] = on_rejected;
+    ret = perform_promise_then(ctx, promise, handlers, resolving_funcs);
+    for (i = 0; i < 2; i++)
+        JS_FreeValue(ctx, resolving_funcs[i]);
+    if (ret) {
+        JS_FreeValue(ctx, result_promise);
+        return JS_EXCEPTION;
+    }
+    return result_promise;
+}
