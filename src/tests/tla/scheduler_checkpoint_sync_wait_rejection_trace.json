{
  "#meta": {
    "format": "ITF",
    "description": "Counterexample trace verifying microtask drain rejection during synchronous wait within checkpoint"
  },
  "vars": ["state", "macro_q", "micro_q", "sync_depth"],
  "states": [
    {
      "#meta": { "index": 0 },
      "action": "init",
      "state": "idle",
      "macro_q": 0,
      "micro_q": 0,
      "sync_depth": 0
    },
    {
      "#meta": { "index": 1 },
      "action": "enqueue_micro",
      "state": "idle",
      "macro_q": 0,
      "micro_q": 1,
      "sync_depth": 0
    },
    {
      "#meta": { "index": 2 },
      "action": "begin_checkpoint",
      "state": "in_checkpoint",
      "macro_q": 0,
      "micro_q": 1,
      "sync_depth": 0
    },
    {
      "#meta": { "index": 3 },
      "action": "begin_sync_wait",
      "state": "in_sync_wait",
      "macro_q": 0,
      "micro_q": 1,
      "sync_depth": 1
    },
    {
      "#meta": { "index": 4 },
      "action": "drain_micro",
      "state": "in_checkpoint",
      "macro_q": 0,
      "micro_q": 0,
      "sync_depth": 1
    }
  ]
}
